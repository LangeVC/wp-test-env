#!/bin/bash
# Generic API Key Setup Script Example for WordPress Plugins
# 
# This is an example script for setting up API keys for WordPress plugin testing.
# Copy this file to setup-yourplugin-api-key.sh and customize for your plugin.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
ENV_FILE="$PROJECT_DIR/.env"

# Configuration - CHANGE THESE FOR YOUR PLUGIN
PLUGIN_SLUG="yourplugin"  # Change to your plugin slug
API_KEY_ENV_VAR="YOURPLUGIN_API_KEY"  # Change to your environment variable name
PLUGIN_NAME="Your Plugin Name"  # Change to your plugin's display name

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if .env file exists
if [ ! -f "$ENV_FILE" ]; then
    error ".env file not found at $ENV_FILE"
    error "Please copy .env.example to .env and configure it first."
    exit 1
fi

# Check if API key is already set
if grep -q "${API_KEY_ENV_VAR}=" "$ENV_FILE" && [ -n "$(grep "${API_KEY_ENV_VAR}=" "$ENV_FILE" | cut -d= -f2 | tr -d '[:space:]')" ]; then
    log "API key already configured in .env"
    exit 0
fi

log "Setting up $PLUGIN_NAME API key..."

# Check if Docker is running and WordPress container is available
if ! docker ps --format '{{.Names}}' | grep -q 'wptesting-wordpress'; then
    warn "WordPress container not found. Starting Docker environment..."
    cd "$PROJECT_DIR" && docker-compose up -d wordpress mysql
    sleep 30 # Wait for services to start
fi

# Check if plugin is active
if ! docker exec wptesting-wordpress wp plugin is-active "$PLUGIN_SLUG" --allow-root 2>/dev/null; then
    error "$PLUGIN_NAME plugin is not active. Please install and activate it first."
    exit 1
fi

log "$PLUGIN_NAME plugin is active."

# Try to generate API key via plugin's REST API
# CUSTOMIZE THIS SECTION FOR YOUR PLUGIN'S API KEY GENERATION ENDPOINT
log "Attempting to generate API key via $PLUGIN_NAME REST API..."
API_RESPONSE=$(curl -s -k -X POST "http://localhost:8082/wp-json/${PLUGIN_SLUG}/v1/auth/generate-key" \
  -H "Content-Type: application/json" \
  -d '{"name":"Testing Environment","permissions":["read","write"]}' 2>/dev/null || true)

# CUSTOMIZE THIS PARSING FOR YOUR PLUGIN'S RESPONSE FORMAT
if echo "$API_RESPONSE" | grep -q '"api_key"' 2>/dev/null; then
    # Extract API key from response
    API_KEY=$(echo "$API_RESPONSE" | grep -o '"api_key":"[^"]*"' | cut -d'"' -f4)
    log "Generated API key via REST API: $API_KEY"
elif echo "$API_RESPONSE" | grep -q '"error"' 2>/dev/null; then
    warn "REST API key generation failed: $(echo "$API_RESPONSE" | grep -o '"message":"[^"]*"' | cut -d'"' -f4)"
else
    # Try alternative method: check if there's a WP-CLI command
    log "REST API endpoint not found, trying WP-CLI method..."
    CLI_RESPONSE=$(docker exec wptesting-wordpress wp eval "
        // CUSTOMIZE THIS PHP CODE FOR YOUR PLUGIN'S API KEY GENERATION
        // Example: if (function_exists('yourplugin_generate_api_key')) {
        //     \$key = yourplugin_generate_api_key('Testing Environment', ['read', 'write']);
        //     echo \$key ?: 'NO_KEY_GENERATED';
        // } else {
        //     echo 'NO_FUNCTION';
        // }
        echo 'CUSTOMIZE_ME';
    " --allow-root 2>/dev/null || echo "CLI_ERROR")
    
    if [ "$CLI_RESPONSE" = "CUSTOMIZE_ME" ]; then
        warn "WP-CLI method needs customization for $PLUGIN_NAME."
    fi
fi

# If automatic generation didn't work, ask for manual input
if [ -z "$API_KEY" ] || [ "$API_KEY" = "CUSTOMIZE_ME" ]; then
    warn "Automatic API key generation not available or needs customization."
    warn "Please generate an API key manually:"
    warn "1. Log into WordPress admin at http://localhost:8082/wp-admin"
    warn "2. Navigate to $PLUGIN_NAME → API Keys (or similar menu)"
    warn "3. Create a new API key with read/write permissions"
    warn "4. Copy the generated key"
    echo ""
    read -p "Enter your API key: " API_KEY
    
    if [ -z "$API_KEY" ]; then
        error "No API key provided. Tests will fail without authentication."
        exit 1
    fi
fi

# Update .env file with API key
if [ -n "$API_KEY" ]; then
    # Remove existing API key line if present
    grep -v "${API_KEY_ENV_VAR}=" "$ENV_FILE" > "${ENV_FILE}.tmp"
    # Add new line
    echo "${API_KEY_ENV_VAR}=$API_KEY" >> "${ENV_FILE}.tmp"
    mv "${ENV_FILE}.tmp" "$ENV_FILE"
    
    log "API key saved to .env file as $API_KEY_ENV_VAR"
    log "Important: Restart Docker containers for changes to take effect:"
    log "  docker-compose restart wordpress"
else
    error "Failed to generate or obtain API key."
    exit 1
fi

log ""
log "Next steps:"
log "1. Review and customize this script for your plugin's API key generation method"
log "2. Update the PLUGIN_SLUG, API_KEY_ENV_VAR, and PLUGIN_NAME variables"
log "3. Customize the API response parsing for your plugin's format"
log "4. Customize the WP-CLI PHP code if your plugin has a CLI function"
log "5. Add this script to your .gitignore if it contains sensitive implementation details"