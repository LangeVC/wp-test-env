# Environment variables
.env
.env.local
.env.*.local

# Logs and reports
*.log
logs/
reports/

# Vendor assets (downloaded libraries and premium plugins)
vendor-assets/

# WordPress uploads (user-generated content)
uploads/

# Temporary files
*.tmp
*.temp
.temp/

# IDE files
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker volumes (auto-generated)
mysql_data/
wordpress_data/

# Plugin ZIPs — free dev tools are committed, everything else ignored
plugins/*
!plugins/README.md
!plugins/debug-bar.zip
!plugins/query-monitor.zip
!plugins/user-switching.zip
!plugins/wordpress-importer.zip

# Themes and uploads
themes/*
!themes/index.php

# Backup files
*.bak
*.backup
backups/

# Test reports
test-results/
coverage/

# Project environments (isolated state per project)
envs/
