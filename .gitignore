# Environment variables
.env
.env.local
.env.*.local

# Logs and reports
*.log
logs/
reports/

# Vendor assets (downloaded libraries)
vendor-assets/

# WordPress uploads (user-generated content)
uploads/

# Temporary files
*.tmp
*.temp
.temp/

# IDE files
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker volumes (auto-generated)
mysql_data/
wordpress_data/

# Plugin files - DO NOT commit actual plugin files to public repository
plugins/*
!plugins/README.md
# Also ignore specific patterns as backup
plugins/*.zip
plugins/*activator*
plugins/*pro*
plugins/*elementify*

# Theme files - WordPress themes (automatically downloaded)
themes/*
!themes/index.php

# Backup files
*.bak
*.backup
backups/

# Test reports
test-results/
coverage/

# Internal documentation and analysis (not for public repository)
_internal/
analysis/

# Elementify-specific test files (not for public repository)
tests/*elementify*
scripts/*elementify*
scripts/setup-api-key.sh

# Example/test API key configuration files
*-api-key.example
.env.*.example